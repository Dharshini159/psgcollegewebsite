<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>PSG College | Coimbatore</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            color: #222;
            background: #fff;
            line-height: 1.6;
        }

        /* TOP BAR */
        .topbar {
            background: #111827;
            color: white;
            padding: 9px 6%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 14px;
        }

        .topbar span {
            margin-right: 20px;
        }

        /* NAVBAR */
        .navbar {
            background: white;
            padding: 15px 6%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 3px 12px rgba(0,0,0,0.08);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-circle {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: #8b0000;
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: bold;
            font-size: 18px;
        }

        .logo-text h2 {
            color: #8b0000;
            font-size: 21px;
        }

        .logo-text p {
            font-size: 12px;
            color: #666;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 25px;
        }

        .nav-links a {
            text-decoration: none;
            color: #333;
            font-weight: 600;
            font-size: 15px;
        }

        .nav-links a:hover {
            color: #8b0000;
        }

        .apply-btn {
            background: #8b0000;
            color: white !important;
            padding: 10px 18px;
            border-radius: 5px;
        }

        .menu-btn {
            display: none;
            font-size: 28px;
            cursor: pointer;
        }

        /* HERO */
        .hero {
            min-height: 580px;
            background:
                linear-gradient(rgba(20, 20, 20, 0.65), rgba(20, 20, 20, 0.65)),
                url("https://images.unsplash.com/photo-1564981797816-1043664bf78d?auto=format&fit=crop&w=1600&q=80");
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            padding: 70px 8%;
            color: white;
        }

        .hero-content {
            max-width: 750px;
        }

        .hero-label {
            display: inline-block;
            background: #d4a017;
            color: white;
            padding: 7px 16px;
            border-radius: 30px;
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 20px;
        }

        .hero h1 {
            font-size: 55px;
            line-height: 1.1;
            margin-bottom: 20px;
        }

        .hero p {
            font-size: 18px;
            max-width: 650px;
            margin-bottom: 30px;
        }

        .hero-buttons {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .primary-btn,
        .secondary-btn {
            padding: 13px 24px;
            border-radius: 5px;
            text-decoration: none;
            font-weight: bold;
            display: inline-block;
        }

        .primary-btn {
            background: #d4a017;
            color: white;
        }

        .secondary-btn {
            border: 2px solid white;
            color: white;
        }

        .primary-btn:hover {
            background: #b58900;
        }

        .secondary-btn:hover {
            background: white;
            color: #333;
        }

        /* NOTICE */
        .notice {
            background: #fff5d7;
            padding: 16px 8%;
            border-left: 5px solid #d4a017;
        }

        .notice strong {
            color: #8b0000;
        }

        /* COMMON SECTION */
        .section {
            padding: 80px 8%;
        }

        .section-heading {
            text-align: center;
            margin-bottom: 45px;
        }

        .section-heading span {
            color: #d4a017;
            font-weight: bold;
            text-transform: uppercase;
            font-size: 14px;
        }

        .section-heading h2 {
            font-size: 38px;
            color: #8b0000;
            margin-top: 8px;
        }

        .section-heading p {
            max-width: 700px;
            margin: 10px auto;
            color: #666;
        }

        /* ABOUT */
        .about {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 55px;
            align-items: center;
        }

        .about-image img {
            width: 100%;
            border-radius: 12px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.15);
        }

        .experience {
            background: #8b0000;
            color: white;
            display: inline-block;
            padding: 15px 22px;
            border-radius: 8px;
            margin-top: 20px;
        }

        .experience strong {
            font-size: 30px;
            display: block;
        }

        .about-content h3 {
            font-size: 30px;
            color: #333;
            margin-bottom: 15px;
        }

        .about-content p {
            color: #666;
            margin-bottom: 15px;
        }

        .check-list {
            list-style: none;
            margin-top: 20px;
        }

        .check-list li {
            margin: 10px 0;
            font-weight: 600;
        }

        .check-list li::before {
            content: "✓";
            color: #8b0000;
            font-weight: bold;
            margin-right: 10px;
        }

        /* STATS */
        .stats {
            background: #8b0000;
            color: white;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            text-align: center;
            padding: 55px 8%;
        }

        .stat h2 {
            font-size: 40px;
            color: #ffd76a;
        }

        .stat p {
            font-size: 15px;
        }

        /* DEPARTMENTS */
        .departments {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .department {
            padding: 30px;
            border-radius: 10px;
            background: white;
            border: 1px solid #eee;
            box-shadow: 0 8px 25px rgba(0,0,0,0.07);
            transition: 0.3s;
        }

        .department:hover {
            transform: translateY(-8px);
            border-top: 4px solid #8b0000;
        }

        .department-icon {
            width: 55px;
            height: 55px;
            background: #fff1f1;
            color: #8b0000;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 50%;
            font-size: 25px;
            margin-bottom: 18px;
        }

        .department h3 {
            color: #8b0000;
            margin-bottom: 10px;
        }

        .department p {
            color: #666;
            margin-bottom: 15px;
        }

        .department button {
            border: none;
            background: #8b0000;
            color: white;
            padding: 9px 15px;
            border-radius: 5px;
            cursor: pointer;
        }

        /* PROGRAMMES */
        .programme-section {
            background: #f7f7f7;
        }

        .programmes {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .programme {
            background: white;
            padding: 28px;
            border-radius: 10px;
            border-bottom: 4px solid #d4a017;
            box-shadow: 0 8px 20px rgba(0,0,0,0.06);
        }

        .programme h3 {
            color: #8b0000;
            margin-bottom: 10px;
        }

        .programme p {
            color: #666;
        }

        /* FACILITIES */
        .facilities {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .facility {
            min-height: 180px;
            background: #8b0000;
            color: white;
            border-radius: 10px;
            padding: 25px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            text-align: center;
        }

        .facility h3 {
            color: #ffd76a;
            margin-bottom: 8px;
        }

        /* ADMISSION */
        .admission-section {
            background: #f7f7f7;
        }

        .admission-box {
            max-width: 900px;
            margin: auto;
            background: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 10px 35px rgba(0,0,0,0.1);
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .form-group.full {
            grid-column: 1 / -1;
        }

        .form-group label {
            font-weight: bold;
            margin-bottom: 7px;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 15px;
        }

        .form-group textarea {
            min-height: 100px;
            resize: vertical;
        }

        .submit-btn {
            margin-top: 20px;
            background: #8b0000;
            color: white;
            border: none;
            padding: 13px 25px;
            border-radius: 5px;
            font-weight: bold;
            cursor: pointer;
        }

        .submit-btn:hover {
            background: #650000;
        }

        /* CONTACT */
        .contact-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .contact-card {
            padding: 30px;
            text-align: center;
            border: 1px solid #eee;
            border-radius: 10px;
        }

        .contact-card .icon {
            font-size: 32px;
            margin-bottom: 12px;
        }

        .contact-card h3 {
            color: #8b0000;
            margin-bottom: 8px;
        }

        .contact-card p {
            color: #666;
        }

        /* FOOTER */
        footer {
            background: #111827;
            color: white;
            padding: 50px 8% 20px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr;
            gap: 40px;
            margin-bottom: 30px;
        }

        footer h2 {
            color: #ffd76a;
            margin-bottom: 12px;
        }

        footer h3 {
            margin-bottom: 12px;
        }

        footer p,
        footer li {
            color: #ccc;
            font-size: 14px;
        }

        footer ul {
            list-style: none;
        }

        footer li {
            margin-bottom: 7px;
        }

        .copyright {
            border-top: 1px solid #444;
            padding-top: 20px;
            text-align: center;
            color: #aaa;
            font-size: 13px;
        }

        /* BACK TO TOP */
        #topBtn {
            display: none;
            position: fixed;
            right: 25px;
            bottom: 25px;
            background: #8b0000;
            color: white;
            border: none;
            width: 45px;
            height: 45px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 20px;
            z-index: 999;
        }

        /* RESPONSIVE */
        @media (max-width: 1000px) {

            .nav-links {
                gap: 14px;
            }

            .departments,
            .programmes {
                grid-template-columns: repeat(2, 1fr);
            }

            .facilities {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 800px) {

            .topbar {
                display: none;
            }

            .menu-btn {
                display: block;
            }

            .nav-links {
                display: none;
                position: absolute;
                top: 82px;
                left: 0;
                right: 0;
                background: white;
                flex-direction: column;
                padding: 25px;
                box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            }

            .nav-links.active {
                display: flex;
            }

            .hero h1 {
                font-size: 42px;
            }

            .about {
                grid-template-columns: 1fr;
            }

            .stats {
                grid-template-columns: repeat(2, 1fr);
                gap: 30px;
            }

            .contact-grid {
                grid-template-columns: 1fr;
            }

            .footer-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 600px) {

            .section {
                padding: 60px 6%;
            }

            .hero {
                padding: 60px 6%;
            }

            .hero h1 {
                font-size: 36px;
            }

            .departments,
            .programmes,
            .facilities {
                grid-template-columns: 1fr;
            }

            .stats {
                grid-template-columns: 1fr 1fr;
                padding: 40px 6%;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .form-group.full {
                grid-column: auto;
            }

            .admission-box {
                padding: 25px;
            }

            .section-heading h2 {
                font-size: 30px;
            }
        }
    </style>
</head>

